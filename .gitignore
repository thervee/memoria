# Files Git must never upload.

# Secrets: your API key lives here
.env
.env.*
!.env.example

# Agent keys: secret signing keys must never be uploaded
keys/
*.key
*.pem
dashboard_password*.json

# API keys saved in text files for testing
test_key.txt
*_key.txt

# Your memories, databases, downloaded models, logs and lock files
memory_store/
memory_store.*/

# Backups of your memories (private, like memory_store)
backups/

# A data folder (MEMORIA_DATA_DIR) and database files, wherever they are
data/
*.db
*.db-wal
*.db-shm

# The Python workspace (re-created with: pip install -r requirements.txt)
.venv/

# Log files anywhere
*.log

# Python's temporary files
__pycache__/
*.pyc

# Railway's config tool (re-created with: npm install)
node_modules/
