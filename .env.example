# Memoria settings template. Copy this file to ".env" and put your Gemini API key in it.

# The AI model that reads memories and builds the knowledge graph (Google Gemini, free tier)
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_API_KEY=PUT_YOUR_GEMINI_KEY_HERE
# Stay under the free-tier speed limit (requests per minute)
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_REQUESTS=8
LLM_RATE_LIMIT_INTERVAL=60

# The search model: runs free on this laptop, nothing sent anywhere
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Automatic backups of memory_store (optional; defaults shown).
# Put them on another disk or a USB drive to survive a disk failure.
# MEMORIA_BACKUP_DIR=E:\MemoriaBackups
# MEMORIA_BACKUP_KEEP=14

# Turn off anonymous usage reporting
TELEMETRY_DISABLED=true

# Skip Cognee's start-up "are you there?" check (it is too impatient for Gemini)
COGNEE_SKIP_CONNECTION_TEST=true
# Windows can't create shortcut files without admin rights; this hides the warning
HF_HUB_DISABLE_SYMLINKS_WARNING=1
