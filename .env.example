# Memoria settings template. Copy this file to ".env" and put your Gemini API key in it.

# The AI model that reads memories and builds the knowledge graph (Google Gemini, free tier)
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_API_KEY=PUT_YOUR_GEMINI_KEY_HERE
# Stay under the free-tier speed limit (requests per minute)
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_REQUESTS=8
LLM_RATE_LIMIT_INTERVAL=60

# The search model: runs free on this laptop, nothing sent anywhere
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Automatic backups of memory_store (optional; defaults shown).
# Put them on another disk or a USB drive to survive a disk failure.
# MEMORIA_BACKUP_DIR=E:\MemoriaBackups
# MEMORIA_BACKUP_KEEP=14

# Hosting online (optional; not needed on this laptop). See "Deploying on Railway" in README.md.
# On Railway these are set as Railway variables, not in a .env file (which never leaves this laptop).
# Run online: 0.0.0.0 and the host's PORT, dashboard off, trust the host's proxy (the Dockerfile sets it)
# MEMORIA_ONLINE=1
# Keep all data (memory_store, keys, backups) in one folder, e.g. a mounted volume (the Dockerfile sets /data)
# MEMORIA_DATA_DIR=/data
# Server secret that locks developers' agent keys. Make one: python manage_accounts.py make-secret
# MEMORIA_SECRET_KEY=
# Developer sign-up: off (default), invite or open
# MEMORIA_SIGNUP=off
# Sign-up also needs (see signup.py): Cloudflare Turnstile's secret key and a Resend API key
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# RESEND_API_KEY=
# MEMORIA_EMAIL_FROM=Memoria <noreply@memoriaagent.site>
# MEMORIA_SITE_URL=https://www.memoriaagent.site
# MEMORIA_SIGNUP_ORIGINS=https://www.memoriaagent.site,https://memoriaagent.site
# Paying with the $MEMORIA token (see billing.py). Off by default: with it off, nothing changes.
# MEMORIA_BILLING=off
# The wallet that receives payments. The server only reads the chain: never put a private key here.
# MEMORIA_TREASURY_ADDRESS=0x7d61Bd6D005B464C9022e1b2FAdD0F16C93E935C
# The $MEMORIA contract and Robinhood Chain
# MEMORIA_TOKEN_ADDRESS=0xc84b411cae3b86eec20e9699256be7c43b17bd35
# MEMORIA_CHAIN_ID=4663
# The chain's JSON-RPC address. The public one is rate-limited; an Alchemy URL works too
# (it contains a key, so set it only in Railway Variables, never in a file in Git).
# MEMORIA_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Price: 1 credit = this many $MEMORIA, and 1 credit = this many actions
# MEMORIA_TOKENS_PER_CREDIT=10000
# MEMORIA_ACTIONS_PER_CREDIT=2
# Credits every account gets once
# MEMORIA_STARTER_CREDITS=10
# Blocks a payment must wait before it can be claimed
# MEMORIA_MIN_CONFIRMATIONS=20
# Read visitors' real addresses from a proxy's X-Forwarded-For (on automatically when online)
# MEMORIA_TRUST_PROXY=0
# Turn the dashboard off (it is always off when online)
# MEMORIA_DASHBOARD=on
# Spam protection (defaults shown)
# MEMORIA_IP_LIMIT=120
# MEMORIA_FAILED_LOGIN_LIMIT=10
# MEMORIA_SIGNUPS_PER_IP=3
# MEMORIA_SIGNUPS_PER_DAY=50
# MEMORIA_MAX_REQUEST_BYTES=64000

# Turn off anonymous usage reporting
TELEMETRY_DISABLED=true

# Skip Cognee's start-up "are you there?" check (it is too impatient for Gemini)
COGNEE_SKIP_CONNECTION_TEST=true
# Windows can't create shortcut files without admin rights; this hides the warning
HF_HUB_DISABLE_SYMLINKS_WARNING=1
